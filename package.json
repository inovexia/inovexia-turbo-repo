{
  "name": "inovexia-turbo-repo",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "db:generate": "pnpm --filter @inovexia/database db:generate",
    "db:push": "pnpm --filter @inovexia/database db:push",
    "db:migrate": "pnpm --filter @inovexia/database db:migrate",
    "db:sql": "pnpm --filter @inovexia/database db:sql",
    "db:studio": "pnpm --filter @inovexia/database db:studio",
    "convert:html": "node scripts/convert-html.mjs",
    "admin:create": "node --env-file=.env scripts/admin-create.mjs",
    "db:seed": "node --env-file=.env scripts/db-seed.mjs"
  },
  "devDependencies": {
    "domhandler": "^5.0.3",
    "entities": "^8.1.0",
    "htmlparser2": "^12.0.0",
    "turbo": "^2.11.7",
    "@inovexia/database": "workspace:*",
    "@inovexia/content": "workspace:*"
  }
}
