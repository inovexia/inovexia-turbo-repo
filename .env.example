# Copy to .env at the repo root and fill in. Both apps and the Prisma CLI
# read this single file.

# MySQL connection. URL-encode special characters in the password
# (& -> %26, ? -> %3F, ! -> %21, ^ -> %5E, @ -> %40, # -> %23).
# Use "localhost" as the host when the app runs on the database server.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Where the web app proxies /api/* requests (the apps/api server).
API_URL="http://localhost:4000"

# The public site address (used for links in notification emails).
SITE_URL="http://localhost:3000"

# Origins allowed to call the API from a browser and to make admin changes
# (comma-separated). Must include the public site address.
CORS_ORIGIN="http://localhost:3000"

# Email notifications for form submissions (SMTP, e.g. a cPanel mailbox).
# Emails are skipped (and logged) until SMTP_HOST and NOTIFY_TO are set.
SMTP_HOST="mail.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"          # true for 465 (SSL), false for 587 (STARTTLS)
SMTP_USER="noreply@example.com"
SMTP_PASS=""
MAIL_FROM="Inovexia Website <noreply@example.com>"
NOTIFY_TO="contact@example.com"   # comma-separate several addresses

# Shared by both apps: the API calls the site's /revalidate after each admin
# save so changes show at once. Any long random string.
REVALIDATE_SECRET="change-me"
# Where the API reaches the web app (defaults to SITE_URL).
# WEB_URL="http://localhost:3000"

# Admin accounts are created with: pnpm admin:create
# Content (blogs, services…) is loaded from the design with: pnpm db:seed
